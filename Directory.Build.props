<Project>

  <!-- ========================================== -->
  <!-- 1. CORE FRAMEWORK & LANGUAGE               -->
  <!-- ========================================== -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Build Output & Performance -->
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
  </PropertyGroup>

  <!-- ========================================== -->
  <!-- 2. ANALYSIS & CODE QUALITY                 -->
  <!-- ========================================== -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <WarningLevel>9999</WarningLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- ========================================== -->
  <!-- 3. CI/CD, SECURITY & DEBUGGING             -->
  <!-- ========================================== -->

  <!-- Deterministic Builds (Triggered only in CI pipelines) -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true' Or '$(TF_BUILD)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- Supply Chain Security -->
  <PropertyGroup>
    <!-- Forces NuGet to check for known vulnerabilities during restore -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
  </PropertyGroup>

  <!-- Debugging & Source Link -->
  <PropertyGroup>
    <!-- Embeds untracked files and SourceLink metadata for accurate CI crash dumps -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- ========================================== -->
  <!-- 4. TEST PROJECT DEFAULTS                   -->
  <!-- ========================================== -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true' Or '$(MSBuildProjectName)' == 'ut' Or '$(MSBuildProjectName)' == 'it'">

    <!-- Standard Test Project Settings -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <GenerateProgramFile>true</GenerateProgramFile>
    <IsPackable>false</IsPackable>
    <OutputType>library</OutputType>

    <!-- Ensure tests don't trigger security audits for test-only packages -->
    <NuGetAudit>false</NuGetAudit>

    <!-- Coverlet MSBuild Code Coverage Settings -->
    <!-- Exclusions -->
    <Exclude>[api]api.DTOs.*,[api]api.Models.*,[api]api.Datas.*,[api]api.Mappers.*,[api]api.Middlewares.*,[api]api.Intefaces.*</Exclude>
    <ExcludeByFile>**/Program.cs,**/*.generated.cs,**/*.g.cs,**/*Designer.cs</ExcludeByFile>
    <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>

    <!-- Optimizations -->
    <IncludeTestAssembly>false</IncludeTestAssembly>
    <SkipAutoProps>true</SkipAutoProps>
    <UseSourceLink>true</UseSourceLink>
    <DeterministicReport>true</DeterministicReport>

    <!-- Minimum coverage thresholds -->
    <Threshold>1</Threshold>
    <ThresholdType>line,branch,method</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
  </PropertyGroup>

</Project>
