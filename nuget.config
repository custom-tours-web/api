<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- ========================================== -->
  <!-- 1. PACKAGE SOURCES & SUPPLY CHAIN          -->
  <!-- ========================================== -->

  <!-- Package Sources -->
  <packageSources>
    <!-- Clear inherited machine-level sources to guarantee only explicitly defined feeds are used -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Package Source Mapping (Supply Chain Security) -->
  <!-- Acts as an allowlist: NuGet will only restore these specific patterns from nuget.org -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="System.*" />
      <package pattern="Microsoft.*" />
      <package pattern="Newtonsoft.*" />
      <package pattern="Mono.*" />
      <package pattern="Humanizer.*" />
      <package pattern="Reqnroll.*" />
      <package pattern="NUnit.*" />
      <package pattern="Cake.*" />
      <package pattern="coverlet.*" />
      <package pattern="Scalar.*" />
      <package pattern="Cucumber.*" />
      <package pattern="Castle.*" />
      <package pattern="SQLitePCLRaw.*" />
      <package pattern="AutoMapper" />
      <package pattern="Gherkin" />
      <package pattern="Moq" />
      <package pattern="Reqnroll" />
      <package pattern="NUnit" />
      <package pattern="NUnit3TestAdapter" />
      <package pattern="dotnet-ef" />
      <package pattern="dotnet-stryker" />
    </packageSource>
  </packageSourceMapping>

  <!-- Fallback Folders (Deterministic Builds) -->
  <fallbackPackageFolders>
    <!-- Clears global fallback folders to guarantee the CI pipeline only builds what is defined here -->
    <clear />
  </fallbackPackageFolders>

  <!-- ========================================== -->
  <!-- 2. PACKAGE RESTORE BEHAVIOR                -->
  <!-- ========================================== -->

  <packageRestore>
    <!-- Explicitly allows NuGet to download missing packages -->
    <add key="enabled" value="True" />
    <!-- Allows NuGet to automatically check for missing packages during build -->
    <add key="automatic" value="True" />
  </packageRestore>

  <!-- ========================================== -->
  <!-- 3. CORE CONFIGURATION & SECURITY           -->
  <!-- ========================================== -->

  <config>
    <!-- Validates package signatures to block tampered packages (Changed from "accept" to "require") -->
    <add key="signatureValidationMode" value="require" />

    <!-- Prevents accidental publishing of internal packages to the public feed (Changed to an empty string) -->
    <add key="defaultPushSource" value="" />
  </config>

</configuration>
