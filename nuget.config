<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Core Configuration & Security -->
  <config>

    <!-- Validates package signatures to block tampered packages -->
    <add key="signatureValidationMode" value="accept" />

    <!-- Prevents accidental publishing of internal packages to the public feed -->
    <add key="defaultPushSource" value="https://api.nuget.org/v3/index.json" />
  </config>

  <!-- Package Restore Behavior -->
  <packageRestore>

    <!-- Explicitly allows NuGet to download missing packages -->
    <add key="enabled" value="True" />

    <!-- Allows NuGet to automatically check for missing packages during build -->
    <add key="automatic" value="True" />
  </packageRestore>

  <!-- Package Sources -->
  <packageSources>

    <!-- To inherit the global NuGet package sources remove the <clear/> line below -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Package Source Mapping (Supply Chain Security) -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="System.*" />
      <package pattern="Microsoft.*" />
      <package pattern="Reqnroll.*" />
      <package pattern="NUnit.*" />
      <package pattern="Cake.*" />
      <package pattern="coverlet.*" />
      <package pattern="dotnet-ef" />
      <package pattern="dotnet-reportgenerator-globaltool" />
      <package pattern="Reqnroll" />
      <package pattern="NUnit" />
      <package pattern="NUnit3TestAdapter" />
    </packageSource>
  </packageSourceMapping>

  <!-- Fallback Folders (Deterministic Builds) -->
  <fallbackPackageFolders>

    <!-- Clears machine-level global fallback folders to guarantee that the CI pipeline only builds what is defined in this config -->
    <clear />
  </fallbackPackageFolders>

</configuration>
