{
  "language": {
    "feature": "en-US",
    "binding": "en-US"
  },
  "bindingCulture": {
    "name": "en-US"
  },

  "runtime": {
    "missingOrPendingStepsOutcome": "Error",
    "obsoleteBehavior": "Error",
    "stopAtFirstError": false
  },

  "generator": {
    "allowDebugGeneratedFiles": false,
    "allowRowTests": true,
    "disableFriendlyTestNames": false,
    "addNonParallelizableMarkerForTags": [
      "sequential",
      "database",
      "nonparallelizable"
    ]
  },
  "trace": {
    "stepDefinitionSkeletonStyle": "CucumberExpressionAttribute"
  },
  "bindingAssemblies": []
}
