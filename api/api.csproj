<Project Sdk='Microsoft.NET.Sdk.Web'>

  <!-- PROJECT METADATA & IDENTITY -->
  <PropertyGroup>
    <Title>Custom Tours &amp; Travels Web API</Title>
    <Version>1.0.0</Version>
    <Description>Production Backend API for the Custom Tours platform</Description>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <NoWarn>$(NoWarn);CA1848;CA1873</NoWarn>
    <UserSecretsId></UserSecretsId>
  </PropertyGroup>

  <!-- CONTAINERIZATION SETTINGS -->
  <PropertyGroup>
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <ContainerImageName>custom-tours-api</ContainerImageName>
  </PropertyGroup>

  <!-- WEB PERFORMANCE & PUBLISHING  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <!-- PACKAGE REFERENCES -->
  <ItemGroup>
    <!-- API Documentation -->
    <PackageReference Include='Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore' />
    <PackageReference Include='Microsoft.OpenApi' />
    <PackageReference Include='Microsoft.AspNetCore.OpenApi' />
    <PackageReference Include='Scalar.AspNetCore' />

    <!-- Data Access & ORM -->
    <PackageReference Include='Microsoft.EntityFrameworkCore.Sqlite' />
    <PackageReference Include='Microsoft.EntityFrameworkCore.Design' />

    <!-- Object Mapping -->
    <PackageReference Include='AutoMapper' />
  </ItemGroup>

</Project>
